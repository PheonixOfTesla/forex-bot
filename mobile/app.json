      "output": "single",
      "name": "Lightning Bot",
      "shortName": "LightningBot",
      "description": "AI-Powered Forex Trading",
      "backgroundColor": "#000000",
      "themeColor": "#00d4ff"
    },
    "plugins": [
      "expo-splash-screen"
    ]
  }
