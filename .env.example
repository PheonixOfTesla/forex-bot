# =============================================================================
# FOREX-BOT ENVIRONMENT CONFIGURATION
# =============================================================================
# Copy this file to .env and fill in your credentials
# NEVER commit your actual .env file to version control!

# -----------------------------------------------------------------------------
# OANDA API CREDENTIALS
# -----------------------------------------------------------------------------
# Get credentials from: https://www.oanda.com/account/tpa/personal_token
OANDA_ACCOUNT_ID=xxx-xxx-xxxxxxx-xxx
OANDA_ACCESS_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
OANDA_ENVIRONMENT=practice  # 'practice' or 'live'

# -----------------------------------------------------------------------------
# BINANCE API CREDENTIALS
# -----------------------------------------------------------------------------
# Get credentials from: https://www.binance.com/en/my/settings/api-management
BINANCE_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
BINANCE_API_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
BINANCE_TESTNET=true  # Set to 'false' for live trading

# -----------------------------------------------------------------------------
# KRAKEN FUTURES API CREDENTIALS (Primary Engine)
# -----------------------------------------------------------------------------
# Get credentials from: https://futures.kraken.com/trade/settings/api
# Generate API keys with "Full Access" for trading
KRAKEN_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
KRAKEN_API_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
KRAKEN_DEMO=true  # Set to 'false' for live trading

# Kraken Tiered Leverage Configuration
# Format: min_confidence,max_confidence,leverage,risk_pct
# Default tiers (if not set):
#   0-65%:  10x leverage, 1% risk (Conservative)
#   65-80%: 25x leverage, 2% risk (Moderate)
#   80-90%: 35x leverage, 3% risk (Aggressive)
#   90-100%: 50x leverage, 4% risk (Max)
KRAKEN_LEVERAGE_TIERS=0,65,10,1.0|65,80,25,2.0|80,90,35,3.0|90,100,50,4.0

# Kraken Circuit Breaker Settings
KRAKEN_MAX_DAILY_LOSS_PCT=5.0
KRAKEN_MAX_CONSECUTIVE_LOSSES=5
KRAKEN_MAX_DRAWDOWN_PCT=15.0
KRAKEN_COOLDOWN_MINUTES=30

# -----------------------------------------------------------------------------
# DATABASE CONFIGURATION
# -----------------------------------------------------------------------------
# PostgreSQL connection string
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/forex_bot
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20

# Redis for caching and message queues
REDIS_URL=redis://localhost:6379/0

# -----------------------------------------------------------------------------
# TELEGRAM ALERTS
# -----------------------------------------------------------------------------
# Create bot with @BotFather: https://t.me/BotFather
TELEGRAM_BOT_TOKEN=0000000000:xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TELEGRAM_CHAT_ID=000000000

# -----------------------------------------------------------------------------
# RISK MANAGEMENT PARAMETERS
# -----------------------------------------------------------------------------
# Maximum risk per trade as percentage of account
RISK_PER_TRADE_PCT=2.0

# Maximum leverage to use (broker may restrict further)
MAX_LEVERAGE=10

# Minimum confidence score required to enter trade (0-100)
MIN_CONFIDENCE_THRESHOLD=70

# Maximum drawdown percentage before stopping trading
MAX_DRAWDOWN_PCT=20.0

# Maximum number of concurrent open positions
MAX_OPEN_POSITIONS=5

# Daily loss limit as percentage of account
DAILY_LOSS_LIMIT_PCT=5.0

# Use Kelly Criterion for position sizing
USE_KELLY_CRITERION=true

# Kelly fraction multiplier (0.25 = quarter Kelly for safety)
KELLY_FRACTION=0.25

# -----------------------------------------------------------------------------
# TRADING PARAMETERS
# -----------------------------------------------------------------------------
# Instruments to trade (comma-separated)
FOREX_PAIRS=EUR_USD,GBP_USD,USD_JPY,AUD_USD
CRYPTO_PAIRS=BTCUSDT,XRPUSDT,ETHUSDT

# Trading hours (UTC) - London Breakout specific
LONDON_SESSION_START=07:00
LONDON_SESSION_END=16:00

# Minimum spread in pips to accept
MAX_SPREAD_PIPS=3.0

# -----------------------------------------------------------------------------
# ML MODEL CONFIGURATION
# -----------------------------------------------------------------------------
# Path to trained model weights
MODEL_PATH=./data/models/

# Feature lookback period in candles
LOOKBACK_PERIOD=50

# Model retraining interval in hours
RETRAIN_INTERVAL_HOURS=24

# Minimum samples required for retraining
MIN_SAMPLES_FOR_RETRAIN=1000

# -----------------------------------------------------------------------------
# API SERVER CONFIGURATION
# -----------------------------------------------------------------------------
API_HOST=0.0.0.0
API_PORT=8000
API_DEBUG=false
API_SECRET_KEY=your-super-secret-key-change-this-in-production

# CORS allowed origins (comma-separated)
CORS_ORIGINS=http://localhost:3000,http://localhost:8080

# -----------------------------------------------------------------------------
# LOGGING CONFIGURATION
# -----------------------------------------------------------------------------
LOG_LEVEL=INFO
LOG_FORMAT=json  # 'json' or 'text'
LOG_FILE=./logs/forex_bot.log

# -----------------------------------------------------------------------------
# BACKTEST CONFIGURATION
# -----------------------------------------------------------------------------
BACKTEST_START_DATE=2023-01-01
BACKTEST_END_DATE=2024-01-01
BACKTEST_INITIAL_CAPITAL=10000
